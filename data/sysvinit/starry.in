#!/bin/sh
# SPDX-License-Identifier: MIT
### BEGIN INIT INFO
# Provides:          starry
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Starry compositor and starboard shell
### END INIT INFO

# The compositor and starboard run as the user starry. seatd (root) hands
# them the display and input devices; starry-launchd (root) starts apps.
# Without a starry user, everything runs as root through seatd-launch.

bindir=@bindir@
compositor=$bindir/starry-compositor
pidfile=/run/starry.pid
log=/run/starry.log
export XDG_RUNTIME_DIR=/run/starry

running() {
	[ -s "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

start_as_starry() {
	mkdir -p "$XDG_RUNTIME_DIR" /var/lib/starry
	chown starry:starry "$XDG_RUNTIME_DIR"
	chown -R starry:starry /var/lib/starry
	chmod 711 "$XDG_RUNTIME_DIR"
	pidof seatd >/dev/null || seatd -g seat -l error >>"$log" 2>&1 </dev/null &
	pidof starry-launchd >/dev/null || "$bindir/starry-launchd" >>"$log" 2>&1 </dev/null &
	for i in $(seq 25); do
		[ -S /run/seatd.sock ] && break
		sleep 0.2
	done
	# start-stop-daemon changes identity, groups included, then execs.
	HOME=/var/lib/starry LIBSEAT_BACKEND=seatd \
		start-stop-daemon -S -c starry -x "$compositor" >>"$log" 2>&1 </dev/null &
	echo $! > "$pidfile"
}

start_as_root() {
	mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
	HOME=/home/root seatd-launch -- "$compositor" >"$log" 2>&1 </dev/null &
	echo $! > "$pidfile"
}

case "${1:-start}" in
	start)
		running && exit 0
		: >"$log"
		if id starry >/dev/null 2>&1; then
			start_as_starry
		else
			start_as_root
		fi
		;;
	stop)
		# Also catches an instance started by hand, without our pidfile.
		killall starry-compositor 2>/dev/null
		for i in $(seq 15); do
			pidof starry-compositor >/dev/null || break
			sleep 0.2
		done
		killall -9 starry-compositor 2>/dev/null
		killall starry-launchd seatd 2>/dev/null
		rm -f "$pidfile"
		;;
	restart)
		"$0" stop
		exec "$0" start
		;;
	status)
		running
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
