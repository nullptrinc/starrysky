#!/bin/sh
# SPDX-License-Identifier: MIT
### BEGIN INIT INFO
# Provides:          constellation
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Constellation broker (/blinks) and system services
### END INIT INFO

bindir=@bindir@
log=/run/constellation.log
services="constellation-power"

case "${1:-start}" in
	start)
		pidof constellationd >/dev/null && exit 0
		"$bindir/constellationd" >>"$log" 2>&1 </dev/null &
		# Services connect on their own once the socket is up; start them anyway.
		for service in $services; do
			"$bindir/$service" >>"$log" 2>&1 </dev/null &
		done
		;;
	stop)
		killall $services constellationd 2>/dev/null
		for i in $(seq 15); do
			pidof constellationd $services >/dev/null || break
			sleep 0.2
		done
		killall -9 $services constellationd 2>/dev/null
		;;
	restart)
		"$0" stop
		exec "$0" start
		;;
	status)
		pidof constellationd >/dev/null
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
